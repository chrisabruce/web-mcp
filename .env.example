# web-mcp configuration for local runs (`cp .env.example .env`).
# In Dokploy, set these in the service's Environment tab instead.

# Outbound proxy for ALL web traffic. Use socks5h:// so DNS is resolved by the proxy.
# Credentials may be embedded: socks5h://user:pass@host:port
# The provider format socks5h://host:port:user:pass is also accepted.
# Leave empty to connect directly.
SOCKS_PROXY=socks5h://127.0.0.1:1080

# Where the MCP endpoint listens (served at http://<bind>/mcp).
# The Docker image overrides this to 0.0.0.0:8787.
WEB_MCP_BIND=127.0.0.1:8787

# Master key (REQUIRED). It is the admin's key: sign in to the web UI at /admin with it,
# use it as a Claude Code bearer token, or as the Claude Desktop sign-in password. It also
# derives the key that encrypts saved site passwords and cookies, so changing it signs
# everyone out and makes those unreadable (user keys created in the UI keep working).
# At least 32 characters: `openssl rand -hex 32`
WEB_MCP_AUTH_TOKEN=

# Public HTTPS base URL. Enables OAuth so Claude Desktop / claude.ai custom connectors can
# sign in (with WEB_MCP_AUTH_TOKEN as the password). Its host is added to the allowlist.
WEB_MCP_PUBLIC_URL=

# Where the SQLite database lives (user keys, saved site logins, sessions).
# The Docker image uses /data; mount a volume there.
WEB_MCP_DATA_DIR=data

# Extra Host header values accepted on /mcp (comma-separated; `*` disables the check).
WEB_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1

# Per-request timeout (seconds) and total attempts per request.
WEB_MCP_TIMEOUT_SECS=30
WEB_MCP_RETRIES=2

# Default max characters of page content returned to Claude per fetch.
WEB_MCP_MAX_CHARS=40000

# TLS/HTTP2 fingerprint to impersonate: chrome, firefox, safari, edge, none.
WEB_MCP_IMPERSONATE=chrome

# Search engines tried in order until one returns results.
# Options: duckduckgo-lite, duckduckgo-html, bing
WEB_MCP_SEARCH_ENGINES=duckduckgo-lite,bing,duckduckgo-html
